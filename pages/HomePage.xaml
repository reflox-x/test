<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="pawledger.pages.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Home"
    BackgroundColor="#F4F4F8">

    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,30" Spacing="18">

            <Grid ColumnDefinitions="*,Auto">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="🐾" FontSize="26" />
                    <Label
                        x:Name="AppTitleLabel"
                        Text="PawLedger"
                        FontSize="28"
                        FontAttributes="Bold"
                        TextColor="#355070" />
                </HorizontalStackLayout>

                <Button
                    Grid.Column="1"
                    Text="+"
                    FontSize="24"
                    WidthRequest="52"
                    HeightRequest="52"
                    CornerRadius="16"
                    BackgroundColor="#F3DC8C"
                    TextColor="#355070"
                    Clicked="OnAddRecordClicked" />
            </Grid>

            <Border
                StrokeShape="RoundRectangle 22"
                Padding="0"
                BackgroundColor="Transparent">
                <Image
                    x:Name="ThemeBannerImage"
                    Source="fox_day.png"
                    Aspect="AspectFill"
                    HeightRequest="180" />
            </Border>

            <Border
                StrokeShape="RoundRectangle 22"
                BackgroundColor="White"
                Padding="18,16">
                <Grid ColumnDefinitions="*,Auto">
                    <Button
                        x:Name="MonthTitleButton"
                        Text="April 2026"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="#355070"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Start"
                        Clicked="OnChangeDateClicked" />

                    <Label
                        Grid.Column="1"
                        Text="›"
                        FontSize="24"
                        TextColor="#90A4B8"
                        VerticalOptions="Center" />
                </Grid>
            </Border>

            <DatePicker
                x:Name="HomeDatePicker"
                Format="yyyy/MM/dd"
                DateSelected="OnHomeDateSelected" />

            <Border
                StrokeShape="RoundRectangle 22"
                BackgroundColor="#DDF3EE"
                Padding="18,14">
                <VerticalStackLayout Spacing="4">
                    <Label
                        x:Name="IncomeTitleLabel"
                        Text="Income"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#4A90A4" />
                    <Label
                        x:Name="IncomeLabel"
                        Text="¥0"
                        FontSize="26"
                        FontAttributes="Bold"
                        TextColor="#355070" />
                </VerticalStackLayout>
            </Border>

            <Border
                StrokeShape="RoundRectangle 22"
                BackgroundColor="#FBE2DF"
                Padding="18,14">
                <VerticalStackLayout Spacing="4">
                    <Label
                        x:Name="ExpenseTitleLabel"
                        Text="Expense"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#D97C7C" />
                    <Label
                        x:Name="ExpenseLabel"
                        Text="¥0"
                        FontSize="26"
                        FontAttributes="Bold"
                        TextColor="#B85C5C" />
                </VerticalStackLayout>
            </Border>

            <Border
                StrokeShape="RoundRectangle 24"
                BackgroundColor="White"
                Padding="18">
                <VerticalStackLayout Spacing="14">
                    <Label>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span
                                    x:Name="BalanceTitleSpan"
                                    Text="Balance  "
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="#E0A83C" />
                                <Span
                                    x:Name="BalanceLabel"
                                    Text="¥0"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="#E0A83C" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <GraphicsView
                        x:Name="BalanceChartView"
                        HeightRequest="140" />
                </VerticalStackLayout>
            </Border>

            <Border
                StrokeShape="RoundRectangle 22"
                BackgroundColor="White"
                Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label
                        x:Name="SummaryTitleLabel"
                        Text="Summary"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="#355070" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            x:Name="TotalTitleLabel"
                            Text="Total"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#234" />
                        <Label
                            Grid.Column="1"
                            x:Name="TotalLabel"
                            Text="¥0"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#2A7B74" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            x:Name="FoodTitleLabel"
                            Text="Food"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#234" />
                        <Label
                            Grid.Column="1"
                            x:Name="FoodLabel"
                            Text="¥0"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#C96A59" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            x:Name="PetTitleLabel"
                            Text="Pet"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#234" />
                        <Label
                            Grid.Column="1"
                            x:Name="PetLabel"
                            Text="¥0"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#6B6FAF" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border
                StrokeShape="RoundRectangle 22"
                BackgroundColor="White"
                Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label
                        x:Name="RecentRecordsTitleLabel"
                        Text="Recent Records"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="#355070" />

                    <CollectionView
                        x:Name="RecentRecordsCollectionView"
                        SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    StrokeShape="RoundRectangle 16"
                                    BackgroundColor="#F9FAFB"
                                    Padding="12"
                                    Margin="0,0,0,10">
                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        RowDefinitions="Auto,Auto,Auto"
                                        RowSpacing="4">

                                        <Label
                                            Text="{Binding Category}"
                                            FontSize="18"
                                            FontAttributes="Bold"
                                            TextColor="#243B53" />

                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding AmountText}"
                                            FontSize="18"
                                            FontAttributes="Bold"
                                            TextColor="{Binding AmountColor}"
                                            HorizontalOptions="End" />

                                        <Label
                                            Grid.Row="1"
                                            Text="{Binding Type}"
                                            FontSize="14"
                                            TextColor="#90A4B8" />

                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Text="{Binding DateText}"
                                            FontSize="14"
                                            TextColor="#90A4B8"
                                            HorizontalOptions="End" />

                                        <Button
                                            Grid.Row="2"
                                            Grid.ColumnSpan="2"
                                            Text="Delete"
                                            BackgroundColor="#FBE2DF"
                                            TextColor="#B85C5C"
                                            CornerRadius="12"
                                            Margin="0,6,0,0"
                                            Clicked="OnDeleteRecordClicked" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>