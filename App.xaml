<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="pawledger.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Page backgrounds -->
            <Color x:Key="PageBackgroundLight">#F4F4F8</Color>
            <Color x:Key="PageBackgroundDark">#1E1E1E</Color>

            <!-- Card backgrounds -->
            <Color x:Key="CardBackgroundLight">#FFFFFF</Color>
            <Color x:Key="CardBackgroundDark">#2A2A2A</Color>

            <!-- Primary text -->
            <Color x:Key="PrimaryTextLight">#355070</Color>
            <Color x:Key="PrimaryTextDark">#F5F5F5</Color>

            <!-- Secondary text -->
            <Color x:Key="SecondaryTextLight">#90A4B8</Color>
            <Color x:Key="SecondaryTextDark">#B8C2CC</Color>

            <!-- Accent colors -->
            <Color x:Key="IncomeCardLight">#DDF3EE</Color>
            <Color x:Key="IncomeCardDark">#21413A</Color>

            <Color x:Key="ExpenseCardLight">#FBE2DF</Color>
            <Color x:Key="ExpenseCardDark">#4A2C2C</Color>

            <Color x:Key="ButtonLight">#F3DC8C</Color>
            <Color x:Key="ButtonDark">#9D7B20</Color>

        </ResourceDictionary>
    </Application.Resources>
</Application>